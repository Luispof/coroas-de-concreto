{
  "name": "coroas-de-concreto",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev:web": "pnpm --filter @cdc/web dev",
    "dev:api": "pnpm --filter @cdc/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @cdc/api test:e2e",
    "db:validate": "pnpm --filter @cdc/api db:validate",
    "db:generate": "pnpm --filter @cdc/api db:generate",
    "db:check": "pnpm --filter @cdc/api db:check",
    "db:up": "docker compose --env-file apps/api/.env up -d --wait db",
    "db:down": "docker compose --env-file apps/api/.env down"
  }
}
